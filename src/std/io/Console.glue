// Console.glue — 标准 IO 顶层入口（stdout/stderr/stdin）
//
// println/print/eprintln/eprint 为同步函数，返回 Throw<Unit, IOError>。
// scan/scanln 为同步函数，返回 Throw<str?, IOError>（null = EOF）。
//
// 格式化委托给 std.reflect.format（Glue 层递归实现，reflect/__scalar_to_str 为边界原语）。
// println 是真正的 Glue 函数，不再依赖编译期内联。
//
// 用法：
//   import std.io.Console.{println}
//   println("hello")           // hello
//   println(Point(3, 4))       // Point(x: 3, y: 4)

import std.reflect.Reflect

// ─── 标准输出 ──────────────────────────────────────────────────────

pub fun print<T>(x: T): Throw<Unit, IOError> {
    val s = std.reflect.Reflect.format(x)
    __stdout_write(s)?
    Ok(())
}

pub fun println<T>(x: T): Throw<Unit, IOError> {
    val s = std.reflect.Reflect.format(x)
    __stdout_write(s)?
    __stdout_write("\n")?
    Ok(())
}

// ─── 标准错误 ──────────────────────────────────────────────────────

pub fun eprint<T>(x: T): Throw<Unit, IOError> {
    val s = std.reflect.Reflect.format(x)
    __stderr_write(s)?
    Ok(())
}

pub fun eprintln<T>(x: T): Throw<Unit, IOError> {
    val s = std.reflect.Reflect.format(x)
    __stderr_write(s)?
    __stderr_write("\n")?
    Ok(())
}

// ─── 标准输入 ─────────────────────────────────────────────────────

// scanln: 读一行（不含换行），EOF 返回 null
pub fun scanln(): Throw<str?, IOError> {
    __stdin_readln()?
}

// scan: 读空白分隔 token，无 token（EOF 或空白行）返回 null
// 用现有 str 原语（len/index/slice）组合实现，无新增内置方法。
pub fun scan(): Throw<str?, IOError> {
    val line = __stdin_readln()?
    val token: str? = match line {
        null => null,
        s => {
            val n = s.len()
            var i: usize = 0
            while i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') {
                i = i + 1
            }
            if i == n {
                null
            } else {
                var j: usize = i
                while j < n && !(s[j] == ' ' || s[j] == '\t' || s[j] == '\n' || s[j] == '\r') {
                    j = j + 1
                }
                s[i..j]
            }
        },
    }
    Ok(token)
}
