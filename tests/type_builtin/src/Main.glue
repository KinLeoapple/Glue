// type_name() builtin — returns the runtime type name of any value

type Color = | Red | Green | Blue
type UserId = UserId(i32)
type Point = Point(x: i32, y: i32)

fun main(): void {
    // ---- primitives: Rust 模式无约束回退 i32/f32 ----
    println(type_name(42))         // i32
    println(type_name(200))        // i32
    println(type_name(100000))     // i32
    println(type_name(3.14))       // f32

    // ---- suffix overrides ----
    println(type_name(42i32))      // i32
    println(type_name(42u64))      // u64
    println(type_name(3.14f32))    // f32

    // ---- annotation overrides ----
    val a: i32 = 42
    val b: u8 = 200
    val c: f64 = 1.5
    println(type_name(a))          // i32
    println(type_name(b))          // u8
    println(type_name(c))          // f64

    // ---- other primitives ----
    println(type_name("hello"))    // str
    println(type_name(true))       // bool
    println(type_name('x'))        // char

    // ---- composite ----
    println(type_name([1, 2, 3]))      // array
    println(type_name((x: 1, y: 2)))   // record

    // ---- user types ----
    println(type_name(Red))            // Color
    println(type_name(Green))          // Color
    println(type_name(UserId(7)))      // UserId
    println(type_name(Point(1, 2)))    // Point

    // ---- throw / ok / error ----
    println(type_name(Ok(5)))          // Throw
    println(type_name(Error("e")))     // Throw

    // ---- functions ----
    println(type_name(fun(x) { x }))   // function

    // ---- type_name() result is a str, usable in interpolation and concat ----
    val t = type_name(42)
    println("kind=" + t)          // kind=i32
    println("the type is {type_name(true)}")  // the type is bool
    println(type_name(t))              // str (type of a type-name is str)

    // ---- type_name() inside match / comparison ----
    val x = 5
    val desc = if type_name(x) == "i32" { "int" } else { "other" }
    println(desc)                 // int

    println("type_builtin: All tests passed!")
}
