fun powNested(base: i64, exp: i32): i64 {
    if exp == 0i32 {
        1i64
    } else {
        if exp % 2 == 1i32 {
            base * powNested(base * base, exp / 2)
        } else {
            powNested(base * base, exp / 2)
        }
    }
}

fun powFlat(base: i64, exp: i32): i64 {
    if exp == 0i32 {
        1i64
    } else {
        if exp % 2 == 1i32 {
            base * powFlat(base * base, exp / 2)
        } else {
            val r = powFlat(base * base, exp / 2)
            r
        }
    }
}

fun main(): void {
    println("=== Bug #45 Diagnostic ===")
    println("powNested(2,0) = {powNested(2,0)} (expected 1)")
    println("powNested(2,1) = {powNested(2,1)} (expected 2)")
    println("powNested(2,2) = {powNested(2,2)} (expected 4, Bug #45 if null)")
    println("powNested(2,3) = {powNested(2,3)} (expected 8)")
    println("powNested(2,4) = {powNested(2,4)} (expected 16, Bug #45 if null)")
    println("---")
    println("powFlat(2,2) = {powFlat(2,2)} (expected 4, workaround)")
    println("powFlat(2,4) = {powFlat(2,4)} (expected 16, workaround)")
}
