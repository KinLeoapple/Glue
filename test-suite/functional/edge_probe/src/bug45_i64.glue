fun recDirect32(x: i32): i32 {
    if x == 0i32 {
        0i32
    } else {
        if x == 1i32 {
            1i32
        } else {
            recDirect32(x - 1)
        }
    }
}

fun recDirect64(x: i64): i64 {
    if x == 0i64 {
        0i64
    } else {
        if x == 1i64 {
            1i64
        } else {
            recDirect64(x - 1)
        }
    }
}

fun rec64Arith(x: i64): i64 {
    if x == 0i64 {
        0i64
    } else {
        if x == 1i64 {
            1i64
        } else {
            1i64 + rec64Arith(x - 1)
        }
    }
}

fun main(): void {
    println("=== i32 vs i64 ===")
    println("recDirect32(3) = {recDirect32(3)} (expected 1)")
    println("recDirect64(3) = {recDirect64(3)} (expected 1)")
    println("rec64Arith(3) = {rec64Arith(3)} (expected 3)")
}
