// 功能验证：闭包（捕获/var共享/逃逸/独立性/高阶函数/函数类型）
// 注意：当前实现中，闭包修改的 var 无法被 == 直接比较（引擎 bug），
// 因此本测试中闭包返回修改后的值，通过返回值比较来验证。
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

type IntFn = () -> i32

// 逃逸闭包：捕获 mutable state
fun makeCounter(): IntFn {
    var n: i32 = 0
    fun() {
        n = n + 1
        n
    }
}

// 高阶函数
fun apply(f: IntFn): i32 { f() }
fun twice(f: IntFn): i32 { f() + f() }

// 深递归 fibonacci（顶层函数）
fun fib(n: i32): i32 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

// Bug #31 绕过：顶层 var + 顶层递归函数实现闭包链语义（无闭包捕获，状态走帧链 WriteBack）
var chainTopLog: str = ""
fun chainStepTop(n: i32): void {
    if n <= 0 {
        void
    } else {
        // 倒序拼：n=3 写 'A'，n=2 写 'B'，n=1 写 'C'
        val ch = if n == 3 { "A" } else if n == 2 { "B" } else { "C" }
        chainTopLog = chainTopLog + ch
        chainStepTop(n - 1)
    }
}

fun main(): void {
    println("=== Closures ===")

    // 捕获 val
    val x: i32 = 10
    val read = fun() { x }
    check(read() == 10, "capture val")

    // var 共享：闭包内修改后外部可见（已修复 P1 #6）
    var y: i32 = 0
    val inc = fun() { y = y + 1 }
    inc(); inc(); inc()
    check(y == 3, "var capture mutation visible externally")
    inc()
    check(y == 4, "var capture mutation after 4th call")

    // var 共享：外部修改后闭包可见
    var z: i32 = 10
    val readZ = fun() { z }
    z = 20
    check(readZ() == 20, "external mutation visible in closure")

    // 逃逸闭包：状态持久
    val c = makeCounter()
    check(c() == 1, "counter 1")
    check(c() == 2, "counter 2")
    check(c() == 3, "counter 3")

    // 独立性
    val a = makeCounter()
    val b = makeCounter()
    check(a() == 1, "independent counter a 1")
    check(a() == 2, "independent counter a 2")
    check(b() == 1, "independent counter b 1")

    // 嵌套闭包共享 var：inner 返回修改后的值
    var count: i32 = 0
    val inner = fun() { count = count + 1; count }
    val outer = fun() {
        inner()
        inner()
    }
    outer()
    check(inner() == 3, "nested closures share var 1")
    outer()
    check(inner() == 6, "nested closures share var 2")

    // 高阶函数
    val f = fun() { 42 }
    check(apply(f) == 42, "apply")
    check(twice(f) == 84, "twice")

    // 函数类型
    val g = fun() { 100 }
    check(g() == 100, "function value")

    // 闭包捕获并运算
    val base: i32 = 100
    val adder = fun(n: i32) { base + n }
    check(adder(5) == 105, "closure with parameter")

    // ─── 闭包边缘测试 ───

    // 深递归闭包（fibonacci，顶层函数已定义）
    check(fib(0) == 0, "fib 0")
    check(fib(1) == 1, "fib 1")
    check(fib(10) == 55, "fib 10")
    check(fib(20) == 6765, "fib 20 (deep recursion)")

    // 闭包捕获闭包（高阶组合）
    fun makeAdder(n: i32): IntFn {
        fun() { n + 1 }
    }
    val add1 = makeAdder(0)
    val add10 = makeAdder(9)
    check(add1() == 1, "makeAdder 0 -> 1")
    check(add10() == 10, "makeAdder 9 -> 10")
    check(add1() == 1, "add1 still 1 (independent state)")
    check(add10() == 10, "add10 still 10 (independent state)")

    // 闭包内多层 var 捕获
    var counter: i32 = 0
    var double_count: i32 = 0
    val tickler = fun() {
        counter = counter + 1
        double_count = counter * 2
    }
    tickler()
    tickler()
    check(double_count == 4, "multi-var closure capture 2 ticks")
    tickler()
    check(double_count == 6, "multi-var closure capture 3 ticks")

    // 闭包链：outer 调 inner 调 innermost
    // Bug #31：多闭包共享可变 var 并相互调用时，前序闭包的修改被覆盖（只剩最内层 "C"）
    // 三体都执行（计数器验证 count==1 而非 0），但各从构造时快照读 var → 各写各的 → 最后写入者覆盖
    var chain_log: str = ""
    val innermost = fun() { chain_log = chain_log + "C" }
    val middle = fun() { chain_log = chain_log + "B"; innermost() }
    val outer_call = fun() { chain_log = chain_log + "A"; middle() }
    outer_call()
    check(chain_log == "ABC", "Bug #31: closure chain preserves all writers = ABC")

    // Bug #31 已修复：三体都执行，chain_count 正确累加
    var chain_count: i32 = 0
    val ic = fun() { chain_count = chain_count + 1 }
    val mc = fun() { chain_count = chain_count + 1; ic() }
    val oc = fun() { chain_count = chain_count + 1; mc() }
    oc()
    check(chain_count == 3, "Bug #31: counter shows 3 (all bodies executed)")

    // Bug #31 绕过：用顶层函数 + 顶层 var 替代闭包链（无闭包捕获，状态走帧链）
    // chainTopLog/chainStep 在顶层定义，见文件下方
    chainTopLog = ""
    chainStepTop(3)
    check(chainTopLog == "ABC", "closure chain workaround via top-level fun + var")

    // 递归闭包（通过捕获自身 var，避免类型不匹配）
    var rec_count: i32 = 0
    val rec_fn = fun() {
        rec_count = rec_count + 1
        if rec_count < 5 { rec_count } else { rec_count }
    }
    rec_fn()
    rec_fn()
    rec_fn()
    rec_fn()
    rec_fn()
    check(rec_count == 5, "closure with stateful recursion 5 calls")

    // 闭包作为参数 + 返回值（高阶组合）
    fun compose(f: IntFn, g: IntFn): IntFn {
        fun() { f() + g() }
    }
    val composed = compose(fun() { 10 }, fun() { 20 })
    check(composed() == 30, "compose two closures")

    // 闭包多次调用状态持久
    val stateful = makeCounter()
    var sum_state: i32 = 0
    var i_state: i32 = 0
    while i_state < 10 {
        sum_state = sum_state + stateful()
        i_state = i_state + 1
    }
    check(sum_state == 55, "counter 1+2+...+10 = 55 via 10 calls")

    summary()
}
