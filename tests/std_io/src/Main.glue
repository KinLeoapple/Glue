// std_io 集成测试：验证 std.io.Console 模块的 println/print/eprintln/eprint
//
// 重点回归：println(42) 必须输出 "42"（而非 "<obj>"）。
// 格式化由编译期类型驱动展开（IRBuilder.formatValueToStr 识别 __format_value），
// 无运行时 trait 分派。
import std.io.Console.{println, print, eprintln, eprint}

// record 类型：验证 record 格式化（Task 9 formatValueToStr 对 record 的实现）
type Point = Point(x: i32, y: i32)

// 多构造器 ADT：位置字段（Option/Lst）和命名字段混合
type Option = | None | Some(i32)
type Lst<T> = | Nil | Cons(T, Lst<T>)
type Shape = | Circle(r: f64) | Rect(w: f64, h: f64) | UnitShape

fun main(): void {
    // ── 标量打印 ──────────────────────────────────────────────
    println(42)               // 预期：42
    println(-7)               // 预期：-7
    println(255u8)            // 预期：255
    println(3.14)             // 预期：3.14
    println(true)             // 预期：true
    println(false)            // 预期：false
    println('a')              // 预期：a
    println(())               // 预期：()
    println(null)             // 预期：null

    // ── 字符串 ────────────────────────────────────────────────
    println("hello")          // 预期：hello
    print("no-newline")       // 预期：no-newline（无换行）
    println("")               // 预期：（空行）

    // ── record 打印 ───────────────────────────────────────────
    // 预期：Point(x: 3, y: 4)
    println(Point(3, 4))

    // ── 数组打印 ───────────────────────────────────────────────
    // 预期：[1, 2, 3]
    println([1, 2, 3])
    // 预期：[9, 8, 7]
    println([9, 8, 7])

    // ── 多构造器 ADT 打印（位置字段） ──────────────────────────
    // 预期：Some(42)
    println(Some(42))
    // 预期：None
    println(None)

    // ── 多构造器 ADT 打印（递归嵌套） ──────────────────────────
    // 预期：Cons(1, Cons(2, Cons(3, Nil)))
    println(Cons(1, Cons(2, Cons(3, Nil))))
    // 预期：Nil
    println(Nil)

    // ── 多构造器 ADT 打印（命名字段 + 无字段混合） ─────────────
    // 预期：Circle(r: 1.5)
    println(Circle(1.5))
    // 预期：Rect(w: 2, h: 3)（整数字面量到 f64 字段强制转换）
    println(Rect(2, 3))
    // 预期：UnitShape
    println(UnitShape)

    // ── stderr ────────────────────────────────────────────────
    eprint("err-msg")         // 预期（stderr）：err-msg（无换行）
    eprintln("err-line")      // 预期（stderr）：err-line

    println("std_io: OK")
}
