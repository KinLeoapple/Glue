// Test: 验证 File.read 基础功能（排除 BufReader 干扰）
import std.io.File

fun main() {
    val path = "/tmp/glue_buf_reader_test.txt"
    std.io.File.remove(path).await()

    val mode = std.io.File.create_rw()
    val f = match std.io.File.open(path, mode).await() {
        Ok(file) => file,
        Error(e) => { println("open failed: " + e.message()); return },
    }
    val data = "first line\nsecond line\n"
    match f.write_all(data.bytes(), data.len()).await() {
        Ok(_) => {},
        Error(e) => { println("write failed: " + e.message()); return },
    }
    f.close().await()

    val ro_mode = std.io.File.read_only()
    val fr = match std.io.File.open(path, ro_mode).await() {
        Ok(file) => file,
        Error(e) => { println("open ro failed: " + e.message()); return },
    }

    // 直接 File.read（返回 u8[]，空数组 = EOF）
    val r = fr.read(64).await()
    match r {
        Ok(bytes) => {
            println("read n=" + cast(bytes.len()).to(str))
            if bytes.len() > 0 {
                println("bytes[0]=" + cast(bytes[0]).to(str))
                println("bytes[1]=" + cast(bytes[1]).to(str))
            }
        },
        Error(e) => println("read err: " + e.message()),
    }

    fr.close().await()
    println("done")
}
