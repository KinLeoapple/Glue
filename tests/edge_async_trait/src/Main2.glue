// 最小测试：非 async &self mutation 持久性
import std.io.Console.{println}

type Counter = Counter(count: i64) {
    pub fun incr(&self): void {
        println("before: " + cast(self.count).to(str))
        self.count = self.count + 1
        println("after: " + cast(self.count).to(str))
    }
}

fun main(): void {
    val c = Counter(0)
    println("init: " + cast(c.count).to(str))
    c.incr()
    println("post: " + cast(c.count).to(str))
}
