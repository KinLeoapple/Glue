// Test: TcpStream.read_until — 验证内部缓冲跨调用共享与分隔符跨批量边界正确性
import std.net.Addr
import std.net.TcpListener
import std.net.TcpStream
import std.io.Console.{println}

// 服务端发送任务：accept 后发送 3 行数据，然后关闭
async fun sender_task(listener: TcpListener): Async<Throw<Unit, IOError>> {
    val ar = listener.accept(0i64).await()?
    val s = std.net.TcpStream.from_accept_fd(ar.stream_fd, ar.peer_addr)
    // 一次性发送 "line1\nline2\nline3\n"（18 字节）
    // 客户端 read_until(DEFAULT_BUF_SIZE=8192) 会一次读入全部到缓冲，
    // 后续 3 次 read_until 调用应从缓冲依次返回各行（验证跨调用缓冲共享）
    val data = "line1\nline2\nline3\n".bytes()
    s.write_all(data, data.len(), 0i64).await()?
    s.close().await()?
    Ok(())
}

fun main() {
    val lo = std.net.Addr.v4_loopback()
    val ip = std.net.Addr.ip_from_v4(lo)
    val addr = std.net.Addr.socket_from(ip, 18091u16)

    val bind_result = std.net.TcpListener.bind(addr, true).await()
    match bind_result {
        Ok(l) => {
            println("bind ok")

            // spawn 服务端发送任务
            val sender = sender_task(l)

            // 客户端连接
            val connect_result = std.net.TcpStream.connect(addr, 0i64).await()
            match connect_result {
                Ok(s) => {
                    println("connect ok")

                    // 第 1 次 read_until：填充缓冲（读入 18 字节），扫描到第一个 \n
                    val r1 = s.read_until(10u8, 0i64).await()
                    match r1 {
                        Ok(line1) => {
                            val ok1 = line1.len() == 6usize
                            println("line1 len=" + cast(line1.len()).to(str) + " ok=" + cast(ok1).to(str))
                        },
                        Error(e) => println("read_until 1 err: " + e.message()),
                    }

                    // 第 2 次 read_until：应从缓冲继续扫描（不调 read），返回 "line2\n"
                    val r2 = s.read_until(10u8, 0i64).await()
                    match r2 {
                        Ok(line2) => {
                            val ok2 = line2.len() == 6usize
                            println("line2 len=" + cast(line2.len()).to(str) + " ok=" + cast(ok2).to(str))
                        },
                        Error(e) => println("read_until 2 err: " + e.message()),
                    }

                    // 第 3 次 read_until：从缓冲继续扫描，返回 "line3\n"
                    val r3 = s.read_until(10u8, 0i64).await()
                    match r3 {
                        Ok(line3) => {
                            val ok3 = line3.len() == 6usize
                            println("line3 len=" + cast(line3.len()).to(str) + " ok=" + cast(ok3).to(str))
                        },
                        Error(e) => println("read_until 3 err: " + e.message()),
                    }

                    // 第 4 次 read_until：缓冲空，read 返回 0（EOF），返回空数组
                    val r4 = s.read_until(10u8, 0i64).await()
                    match r4 {
                        Ok(empty) => {
                            val ok4 = empty.len() == 0usize
                            println("line4 len=" + cast(empty.len()).to(str) + " ok=" + cast(ok4).to(str))
                        },
                        Error(e) => println("read_until 4 err: " + e.message()),
                    }

                    s.close().await()
                },
                Error(e) => println("connect err: " + e.message()),
            }

            // 等待服务端任务完成
            val sender_result = sender.await()
            match sender_result {
                Ok(_) => println("sender done ok"),
                Error(e) => println("sender err: " + e.message()),
            }

            l.close().await()
        },
        Error(e) => println("bind err: " + e.message()),
    }

    println("net_tcp_read_until: done")
}
