// 功能验证：类型转换（widening/narrowing/int-float/链式cast）
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

fun main(): void {
    println("=== Cast ===")

    // Widening: i8 → i16 → i32 → i64
    check(cast(42i8).to(i64) == 42i64, "widen i8 to i64")
    check(cast(100i16).to(i32) == 100, "widen i16 to i32")
    check(cast(1000i32).to(i64) == 1000i64, "widen i32 to i64")

    // Narrowing: wrapping
    check(cast(300i32).to(i8) == 44, "narrow i32 300 to i8 (wrap)")
    check(cast(256i32).to(u8) == 0, "narrow i32 256 to u8 (wrap)")
    check(cast((-1i32)).to(u8) == 255, "narrow i32 -1 to u8 (wrap)")
    check(cast(50000u16).to(u8) == 80, "narrow u16 50000 to u8 (wrap)")

    // Int → Float
    check(cast(42i32).to(f64) == 42.0f64, "i32 to f64")
    check(cast(0i32).to(f64) == 0.0f64, "zero i32 to f64")

    // Float → Int (truncation)
    check(cast(3.14f64).to(i32) == 3, "f64 3.14 to i32 truncate")
    check(cast(3.99f64).to(i32) == 3, "f64 3.99 to i32 truncate")
    check(cast((-2.7f64)).to(i32) == -2, "f64 -2.7 to i32 truncate")

    // 链式 cast
    check(cast(cast(100i32).to(i64)).to(i8) == 100, "chained i32->i64->i8")

    // cast 在算术中
    val a: i32 = 100
    val b: i64 = cast(a).to(i64) * 2i64
    check(b == 200i64, "cast in arithmetic")

    // signed <-> unsigned
    val neg: i8 = -1
    check(cast(neg).to(u8) == 255, "i8 -1 to u8")
    check(cast(neg).to(i64) == -1i64, "i8 -1 to i64 (sign extend)")

    // widening u8 -> u16 -> u32
    val u8v: u8 = 200
    check(cast(u8v).to(u16) == 200, "u8 to u16")
    check(cast(u8v).to(u32) == 200, "u8 to u32")

    // narrowing i64 -> i16 (in range)
    val big: i64 = 1000
    check(cast(big).to(i16) == 1000, "i64 to i16 in range")

    // char <-> int
    val c: char = 'A'
    check(cast(c).to(i32) == 65, "char A to i32")

    // int -> str
    check(cast(42i32).to(str) == "42", "i32 to str")
    check(cast(0i32).to(str) == "0", "zero to str")

    // float -> str
    check(cast(true).to(str) == "true", "bool true to str")
    check(cast(false).to(str) == "false", "bool false to str")

    // 嵌套泛型 cast：cast(cast(x).to(f64)).to(T)
    check(double_cast(3.14) == 3.14, "nested cast f64 roundtrip")
    check(double_cast(42) == 42, "nested cast i32 roundtrip")

    summary()
}

// 嵌套泛型 cast：cast(cast(x).to(f64)).to(T)
fun double_cast<T>(x: T): T {
    cast(cast(x).to(f64)).to(T)
}
