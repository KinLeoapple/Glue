// 功能验证：控制流（if/else/match/while/break/块表达式）
// 注意：defer 不执行仍是引擎 bug（参见 BUG_REPORT.md #10），本测试避开 defer。
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

fun classify(n: i32): str {
    if n > 0 {
        "positive"
    } else if n < 0 {
        "negative"
    } else {
        "zero"
    }
}

fun dayName(n: i32): str {
    match n {
        0 => "Sunday"
        1 => "Monday"
        2 => "Tuesday"
        3 => "Wednesday"
        4 => "Thursday"
        5 => "Friday"
        6 => "Saturday"
        _ => "unknown"
    }
}

fun weekend(n: i32): bool {
    match n {
        0 | 6 => true
        _ => false
    }
}

fun parity(n: i32): str {
    match n {
        n if n % 2 == 0 => "even"
        _ => "odd"
    }
}

fun sumRange(n: i32): i32 {
    var i: i32 = 0
    var s: i32 = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    s
}

fun main(): void {
    println("=== Control Flow ===")

    // if/else if/else
    check(classify(5) == "positive", "if positive")
    check(classify(-3) == "negative", "if negative")
    check(classify(0) == "zero", "if zero")

    // if as expression
    val sign = if 5 > 3 { 1 } else { -1 }
    check(sign == 1, "if as expression")

    // match
    check(dayName(0) == "Sunday", "match Sunday")
    check(dayName(3) == "Wednesday", "match Wednesday")
    check(dayName(6) == "Saturday", "match Saturday")
    check(dayName(99) == "unknown", "match default")

    // match with or-pattern
    check(weekend(0) == true, "or-pattern Saturday")
    check(weekend(6) == true, "or-pattern Sunday")
    check(weekend(3) == false, "or-pattern weekday")

    // match with guard
    check(parity(4) == "even", "guard even")
    check(parity(7) == "odd", "guard odd")

    // while loop（通过函数返回值验证，避开 var 比较的潜在问题）
    check(sumRange(10) == 45, "while sum 0..9")
    check(sumRange(5) == 10, "while sum 0..4")
    check(sumRange(0) == 0, "while sum empty")

    // while break（已修复 P2 #11）
    var breakJ: i32 = 0
    while breakJ < 100 {
        if breakJ >= 5 { break }
        breakJ = breakJ + 1
    }
    check(breakJ == 5, "while break exits at 5")

    // block expression
    val blockVal = {
        val a = 3
        val b = 4
        a + b
    }
    check(blockVal == 7, "block expression value")

    // nested block in expression
    val x = {
        val a = 10
        a * 2
    } + 5
    check(x == 25, "block in arithmetic")

    // match as expression
    val label = match 3 {
        1 => "one"
        2 => "two"
        _ => "many"
    }
    check(label == "many", "match as expression")

    // nested match
    fun nestedMatch(a: i32, b: i32): i32 {
        match a {
            0 => b
            _ => match b {
                0 => a
                _ => a + b
            }
        }
    }
    check(nestedMatch(0, 5) == 5, "nested match 0,5")
    check(nestedMatch(3, 0) == 3, "nested match 3,0")
    check(nestedMatch(3, 5) == 8, "nested match 3,5")

    // if-else chain returns
    fun grade(score: i32): str {
        if score >= 90 { "A" }
        else if score >= 80 { "B" }
        else if score >= 70 { "C" }
        else if score >= 60 { "D" }
        else { "F" }
    }
    check(grade(95) == "A", "grade A")
    check(grade(85) == "B", "grade B")
    check(grade(75) == "C", "grade C")
    check(grade(65) == "D", "grade D")
    check(grade(55) == "F", "grade F")

    summary()
}
