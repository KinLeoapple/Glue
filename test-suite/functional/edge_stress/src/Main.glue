// 边缘压力测试：深递归/大数组/百万循环/多闭包/内存压力
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

// 深递归（1000 层）
fun deepRec(n: i32): i32 {
    if n <= 0 { 0 } else { 1 + deepRec(n - 1) }
}

// 尾递归累加
fun tailSum(n: i32, acc: i32): i32 {
    if n <= 0 { acc } else { tailSum(n - 1, acc + n) }
}

// fibonacci 递归
fun fib(n: i32): i32 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

// 递归 ADT（顶层定义，避免 Bug #19 嵌套递归）
type Lst = | Nil | Cons(i32, Lst)
fun lstLen(l: Lst): i32 {
    match l {
        Nil => 0
        Cons(_, t) => 1 + lstLen(t)
    }
}

// ackermann（测试深栈）
fun ack(m: i32, n: i32): i32 {
    if m == 0 {
        n + 1
    } else if n == 0 {
        ack(m - 1, 1)
    } else {
        ack(m - 1, ack(m, n - 1))
    }
}

fun main(): void {
    println("=== Edge Stress ===")

    // 深递归 1000 层
    check(deepRec(1000) == 1000, "1000-deep recursion")
    check(deepRec(1) == 1, "1-deep recursion")
    check(deepRec(0) == 0, "0-deep recursion base")

    // 尾递归累加 1000
    check(tailSum(1000, 0) == 500500, "tailSum 1000 = 500500")
    check(tailSum(100, 0) == 5050, "tailSum 100 = 5050")

    // fibonacci 30（约 832040）
    check(fib(30) == 832040, "fib(30) = 832040")
    check(fib(20) == 6765, "fib(20) = 6765")

    // ackermann（小值，避免栈溢出）
    check(ack(0, 0) == 1, "ack(0,0) = 1")
    check(ack(1, 1) == 3, "ack(1,1) = 3")
    check(ack(2, 3) == 9, "ack(2,3) = 9")
    check(ack(3, 3) == 61, "ack(3,3) = 61")

    // 大循环（10000 次迭代）
    var loop_sum: i32 = 0
    var i: i32 = 0
    while i < 10000 {
        loop_sum = loop_sum + 1
        i = i + 1
    }
    check(loop_sum == 10000, "10000-iteration loop")

    // 大数组构建（1000 元素通过拼接）
    var big_arr: i32[] = []
    var bi: i32 = 0
    while bi < 1000 {
        big_arr = big_arr ++ [bi]
        bi = bi + 1
    }
    check(big_arr.len() == 1000, "1000-element array via concat")
    check(big_arr[0] == 0, "1000-elem [0]")
    check(big_arr[999] == 999, "1000-elem [999]")

    // 大数组求和
    var arr_sum: i64 = 0
    var si: i32 = 0
    while si < big_arr.len() {
        arr_sum = arr_sum + big_arr[si]
        si = si + 1
    }
    check(arr_sum == 499500, "1000-elem sum = 499500")

    // 多闭包同时存活（闭包不支持显式返回类型，省略 : i32）
    var closures_sum: i32 = 0
    var ci: i32 = 0
    while ci < 10 {
        val captured = ci
        val fn = fun() { captured }
        closures_sum = closures_sum + fn()
        ci = ci + 1
    }
    check(closures_sum == 45, "10 closures sum 0+1+...+9 = 45")

    // 嵌套循环矩阵乘法（3x3）
    var matrix_result: i32 = 0
    var mi: i32 = 0
    while mi < 3 {
        var mj: i32 = 0
        while mj < 3 {
            matrix_result = matrix_result + mi * 3 + mj
            mj = mj + 1
        }
        mi = mi + 1
    }
    check(matrix_result == 36, "3x3 matrix iteration sum = 36")

    // 字符串构建压力（500 次拼接）
    var long_str: str = ""
    var ssi: i32 = 0
    while ssi < 500 {
        long_str = long_str + "x"
        ssi = ssi + 1
    }
    check(long_str.len() == 500, "500-char string built via concat")

    // 递归 ADT 深度（20 层 Cons 列表）
    // type 定义已在顶层
    var deep_lst: Lst = Nil
    var li: i32 = 0
    while li < 20 {
        deep_lst = Cons(li, deep_lst)
        li = li + 1
    }
    check(lstLen(deep_lst) == 20, "20-deep recursive ADT list")

    // ─── 深递归极限（寻找上限）───
    println("--- Deep Recursion Limits ---")
    check(deepRec(2000) == 2000, "2000-deep recursion")
    check(deepRec(3000) == 3000, "3000-deep recursion")
    check(tailSum(3000, 0) == 4501500, "tailSum 3000 = 4501500")
    check(fib(28) == 317811, "fib(28) = 317811 (heavy recursion)")
    check(ack(2, 8) == 19, "ack(2,8) = 19")
    check(ack(3, 3) == 61, "ack(3,3) = 61 (nested recursion)")

    // ─── 索引数组赋值（Bug #34 已修复：arr[i] = x 原地修改数组）───
    println("--- Indexed Array Assignment (Bug #34 fixed) ---")
    // Bug #34 已修复：`arr[i] = x` 原地修改 Array 堆对象的 elements 向量。
    // 根因：IR 编译器对 Assignment target 为 Expr::Index 的情况未生成 array_store
    //   compute_fn，赋值静默丢弃。修复后生成 CF_ARRAY_STORE 节点（三输入：arr, index, value）。
    val bug34_arr: i32[] = [10, 20, 30, 40, 50]
    bug34_arr[0] = 99
    check(bug34_arr[0] == 99, "arr[0]=99 after assignment")
    bug34_arr[2] = 77
    check(bug34_arr[2] == 77, "arr[2]=77 after assignment")
    check(bug34_arr.len() == 5, "array length unchanged after in-bounds assignment")
    // 冒泡排序验证（依赖 arr[i]=x 原地修改）
    var sort_arr: i32[] = [5, 3, 1, 4, 2]
    var si: i32 = 0
    while si < sort_arr.len() {
        var sj: i32 = 0
        while sj < sort_arr.len() - 1 - si {
            if sort_arr[sj] > sort_arr[sj + 1] {
                val tmp = sort_arr[sj]
                sort_arr[sj] = sort_arr[sj + 1]
                sort_arr[sj + 1] = tmp
            }
            sj = sj + 1
        }
        si = si + 1
    }
    check(sort_arr[0] == 1, "bubble sort [0] = 1")
    check(sort_arr[4] == 5, "bubble sort [4] = 5")
    check(sort_arr.len() == 5, "bubble sort length = 5")

    // ─── 数组构建压力（500 元素拼接 + 求和，无原地修改）───
    println("--- Array Build 500 (no in-place mutation) ---")
    var build_arr: i32[] = []
    var bai: i32 = 0
    while bai < 500 {
        build_arr = build_arr ++ [bai * 2]
        bai = bai + 1
    }
    check(build_arr.len() == 500, "500-element array via concat")
    check(build_arr[0] == 0, "build [0] = 0")
    check(build_arr[499] == 998, "build [499] = 998")
    var build_sum: i64 = 0
    var bsi2: i32 = 0
    while bsi2 < build_arr.len() {
        build_sum = build_sum + build_arr[bsi2]
        bsi2 = bsi2 + 1
    }
    // sum of 0,2,4,...,998 = 2*(0+1+...+499) = 2*124750 = 249500
    check(build_sum == 249500, "500-elem even sum = 249500")

    // ─── 字符串构建压力（2000 次拼接）───
    println("--- String Build 2000 ---")
    var long_str2: str = ""
    var ssi3: i32 = 0
    while ssi3 < 2000 {
        long_str2 = long_str2 + "ab"
        ssi3 = ssi3 + 1
    }
    check(long_str2.len() == 4000, "4000-char string (2000 x 'ab')")

    // ─── 50 个闭包同时存活求和 ───
    println("--- 50 Closures Alive ---")
    var closure_arr: i32[] = []
    var cai: i32 = 0
    while cai < 50 {
        closure_arr = closure_arr ++ [cai * cai]
        cai = cai + 1
    }
    var csum: i32 = 0
    var ci2: i32 = 0
    while ci2 < closure_arr.len() {
        val captured = closure_arr[ci2]
        val fn = fun() { captured }
        csum = csum + fn()
        ci2 = ci2 + 1
    }
    // sum of squares 0..49 = 49*50*99/6 = 40425
    check(csum == 40425, "50 closures sum of squares 0..49 = 40425")

    // ─── 嵌套 ADT 深度（50 层）───
    println("--- 50-deep recursive ADT ---")
    var deep_lst2: Lst = Nil
    var li2: i32 = 0
    while li2 < 50 {
        deep_lst2 = Cons(li2, deep_lst2)
        li2 = li2 + 1
    }
    check(lstLen(deep_lst2) == 50, "50-deep recursive ADT list")

    summary()
}
