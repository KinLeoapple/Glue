// Iter<T>: 数组迭代器（builtin 实现）
//
// 包装数组引用 + 游标，提供 next() 方法逐元素推进。
// 用法：
//   val iter = arr.iter()
//   val v = iter.next()  // T? — null 表示耗尽
//
// 仅支持数组迭代；字符串迭代请用索引或转 u8[]。

type Iter<T> = Iter(data: T[], pos: usize) {
    pub fun next(self: Iter<T>): T? {
        if self.pos >= self.data.len() {
            return null
        }
        val v = self.data[self.pos]
        self.pos = self.pos + 1
        return v
    }
}

// 从数组创建迭代器
pub fun iter<T>(arr: T[]): Iter<T> {
    Iter(arr, 0)
}
