// 功能验证：控制流（if/else/match/while/break/块表达式）
// 注意：defer 不执行仍是引擎 bug（参见 BUG_REPORT.md #10），本测试避开 defer。
var failures: i32 = 0

fun check(cond: bool, name: str): void {
    if cond {
        println("  PASS: {name}")
    } else {
        failures = failures + 1
        println("  FAIL: {name}")
    }
}

fun summary(): void {
    println("")
    if failures == 0 {
        println("RESULT: ALL PASSED")
    } else {
        println("RESULT: {failures} FAILED")
    }
}

fun classify(n: i32): str {
    if n > 0 {
        "positive"
    } else if n < 0 {
        "negative"
    } else {
        "zero"
    }
}

fun dayName(n: i32): str {
    match n {
        0 => "Sunday"
        1 => "Monday"
        2 => "Tuesday"
        3 => "Wednesday"
        4 => "Thursday"
        5 => "Friday"
        6 => "Saturday"
        _ => "unknown"
    }
}

fun weekend(n: i32): bool {
    match n {
        0 | 6 => true
        _ => false
    }
}

fun parity(n: i32): str {
    match n {
        n if n % 2 == 0 => "even"
        _ => "odd"
    }
}

fun sumRange(n: i32): i32 {
    var i: i32 = 0
    var s: i32 = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    s
}

// 深递归累加（顶层函数）
fun sumTo(n: i32): i32 {
    if n <= 0 { 0 } else { n + sumTo(n - 1) }
}

// while 嵌套 break 组合（顶层函数，避免 Bug #30：&& 在 while 条件中导致 stuck）
fun findPair(target: i32): i32 {
    var found: i32 = -1
    var i: i32 = 0
    while i < 10 {
        if found != -1 { break }
        var j: i32 = 0
        while j < 10 {
            if i * 10 + j == target {
                found = i
                break
            }
            j = j + 1
        }
        i = i + 1
    }
    found
}

// 深递归 + match 组合（顶层函数，避免 Bug #19：嵌套函数不支持自递归）
fun collatz(n: i32, steps: i32): i32 {
    if n <= 1 { steps }
    else {
        match n % 2 {
            0 => collatz(n / 2, steps + 1)
            _ => collatz(3 * n + 1, steps + 1)
        }
    }
}

fun main(): void {
    println("=== Control Flow ===")

    // if/else if/else
    check(classify(5) == "positive", "if positive")
    check(classify(-3) == "negative", "if negative")
    check(classify(0) == "zero", "if zero")

    // if as expression
    val sign = if 5 > 3 { 1 } else { -1 }
    check(sign == 1, "if as expression")

    // match
    check(dayName(0) == "Sunday", "match Sunday")
    check(dayName(3) == "Wednesday", "match Wednesday")
    check(dayName(6) == "Saturday", "match Saturday")
    check(dayName(99) == "unknown", "match default")

    // match with or-pattern
    check(weekend(0) == true, "or-pattern Saturday")
    check(weekend(6) == true, "or-pattern Sunday")
    check(weekend(3) == false, "or-pattern weekday")

    // match with guard
    check(parity(4) == "even", "guard even")
    check(parity(7) == "odd", "guard odd")

    // while loop（通过函数返回值验证，避开 var 比较的潜在问题）
    check(sumRange(10) == 45, "while sum 0..9")
    check(sumRange(5) == 10, "while sum 0..4")
    check(sumRange(0) == 0, "while sum empty")

    // while break（已修复 P2 #11）
    var breakJ: i32 = 0
    while breakJ < 100 {
        if breakJ >= 5 { break }
        breakJ = breakJ + 1
    }
    check(breakJ == 5, "while break exits at 5")

    // block expression
    val blockVal = {
        val a = 3
        val b = 4
        a + b
    }
    check(blockVal == 7, "block expression value")

    // nested block in expression
    val x = {
        val a = 10
        a * 2
    } + 5
    check(x == 25, "block in arithmetic")

    // match as expression
    val label = match 3 {
        1 => "one"
        2 => "two"
        _ => "many"
    }
    check(label == "many", "match as expression")

    // nested match
    fun nestedMatch(a: i32, b: i32): i32 {
        match a {
            0 => b
            _ => match b {
                0 => a
                _ => a + b
            }
        }
    }
    check(nestedMatch(0, 5) == 5, "nested match 0,5")
    check(nestedMatch(3, 0) == 3, "nested match 3,0")
    check(nestedMatch(3, 5) == 8, "nested match 3,5")

    // if-else chain returns
    fun grade(score: i32): str {
        if score >= 90 { "A" }
        else if score >= 80 { "B" }
        else if score >= 70 { "C" }
        else if score >= 60 { "D" }
        else { "F" }
    }
    check(grade(95) == "A", "grade A")
    check(grade(85) == "B", "grade B")
    check(grade(75) == "C", "grade C")
    check(grade(65) == "D", "grade D")
    check(grade(55) == "F", "grade F")

    // ─── 控制流边缘测试 ───

    // 三层嵌套循环
    var triple_sum: i32 = 0
    var i3: i32 = 0
    while i3 < 3 {
        var j3: i32 = 0
        while j3 < 3 {
            var k3: i32 = 0
            while k3 < 3 {
                triple_sum = triple_sum + 1
                k3 = k3 + 1
            }
            j3 = j3 + 1
        }
        i3 = i3 + 1
    }
    check(triple_sum == 27, "triple nested loop 3*3*3 = 27")

    // 嵌套 break：内层 break 不影响外层
    var outer_count: i32 = 0
    var inner_broke: i32 = 0
    var oi: i32 = 0
    while oi < 5 {
        var ii: i32 = 0
        while ii < 10 {
            if ii >= 3 { break }
            inner_broke = inner_broke + 1
            ii = ii + 1
        }
        outer_count = outer_count + 1
        oi = oi + 1
    }
    check(outer_count == 5, "outer loop runs all 5 iterations")
    check(inner_broke == 15, "inner break: 3*5 = 15 iterations")

    // 深递归（顶层函数 sumTo 已定义）
    check(sumTo(100) == 5050, "deep recursion sumTo 100")
    check(sumTo(0) == 0, "recursion base case")
    check(sumTo(1) == 1, "recursion single step")

    // 多 arm match（10+ 分支）
    fun dayName10(n: i32): str {
        match n {
            0 => "Sun"
            1 => "Mon"
            2 => "Tue"
            3 => "Wed"
            4 => "Thu"
            5 => "Fri"
            6 => "Sat"
            7 => "Extra1"
            8 => "Extra2"
            9 => "Extra3"
            _ => "unknown"
        }
    }
    check(dayName10(0) == "Sun", "10-arm match 0")
    check(dayName10(5) == "Fri", "10-arm match 5")
    check(dayName10(9) == "Extra3", "10-arm match 9")
    check(dayName10(99) == "unknown", "10-arm match default")

    // 复杂布尔条件
    fun complexCond(a: i32, b: i32, c: i32): bool {
        (a > 0 && b > 0) || (c > 0 && a + b > c)
    }
    check(complexCond(1, 1, 0) == true, "complex cond (1,1,0)")
    check(complexCond(-1, 1, 0) == false, "complex cond (-1,1,0)")
    check(complexCond(-1, -1, 5) == false, "complex cond c not enough (a+b=-2 > 5 is false)")
    check(complexCond(-1, -1, 0) == false, "complex cond all fail")

    // if-else 深嵌套（5 层）
    fun deepIf(n: i32): i32 {
        if n > 1000 {
            if n > 2000 {
                if n > 3000 {
                    if n > 4000 {
                        if n > 5000 { 6 } else { 5 }
                    } else { 4 }
                } else { 3 }
            } else { 2 }
        } else { 1 }
    }
    check(deepIf(500) == 1, "deep if level 1")
    check(deepIf(1500) == 2, "deep if level 2")
    check(deepIf(5500) == 6, "deep if level 6")

    // while 嵌套 break 组合（Bug #30：&& 在 while 条件中导致 event loop stuck，改用 if+break）
    check(findPair(42) == 4, "find pair 42 -> i=4")
    check(findPair(99) == 9, "find pair 99 -> i=9")
    check(findPair(100) == -1, "find pair 100 -> not found")

    // ─── 大胆：4 层嵌套循环 ───
    var quad_sum: i32 = 0
    var qi: i32 = 0
    while qi < 2 {
        var qj: i32 = 0
        while qj < 2 {
            var qk: i32 = 0
            while qk < 2 {
                var ql: i32 = 0
                while ql < 2 {
                    quad_sum = quad_sum + qi * 8 + qj * 4 + qk * 2 + ql
                    ql = ql + 1
                }
                qk = qk + 1
            }
            qj = qj + 1
        }
        qi = qi + 1
    }
    // sum of all 4-bit combos 0..15 = 120
    check(quad_sum == 120, "4-layer nested loop sum = 120")

    // ─── 大胆：break 只跳出最内层（4 层）───
    var break_count: i32 = 0
    var bi4: i32 = 0
    while bi4 < 3 {
        var bj4: i32 = 0
        while bj4 < 3 {
            var bk4: i32 = 0
            while bk4 < 3 {
                if bk4 >= 1 { break }
                break_count = break_count + 1
                bk4 = bk4 + 1
            }
            bj4 = bj4 + 1
        }
        bi4 = bi4 + 1
    }
    // 每次最内层只执行 1 次（bk4=0），3*3=9 次
    check(break_count == 9, "break only innermost in 4-layer = 9")

    // ─── 大胆：match 在 while 循环内 ───
    var match_loop_sum: i32 = 0
    var mi2: i32 = 0
    while mi2 < 6 {
        val label = match mi2 {
            0 => 100
            1 => 200
            2 => 300
            _ => 1
        }
        match_loop_sum = match_loop_sum + label
        mi2 = mi2 + 1
    }
    // 100 + 200 + 300 + 1 + 1 + 1 = 603
    check(match_loop_sum == 603, "match in while loop sum = 603")

    // ─── 大胆：if-else 链在 while 内（状态机）───
    // 周期 3：0→1→2→0→...，迭代 10 次（step 0..9），10 mod 3 = 1 → state=1
    var state: i32 = 0
    var step: i32 = 0
    while step < 10 {
        if state == 0 {
            state = 1
        } else if state == 1 {
            state = 2
        } else if state == 2 {
            state = 0
        }
        step = step + 1
    }
    check(state == 1, "state machine after 10 iters = 1 (period 3, 10 mod 3 = 1)")
    // 12 次迭代正好回到 0
    var state2: i32 = 0
    var step2: i32 = 0
    while step2 < 12 {
        if state2 == 0 {
            state2 = 1
        } else if state2 == 1 {
            state2 = 2
        } else {
            state2 = 0
        }
        step2 = step2 + 1
    }
    check(state2 == 0, "state machine after 12 iters = 0 (full period)")

    // ─── 大胆：嵌套 if-else + match 组合 ───
    fun complexFlow(n: i32): i32 {
        if n > 10 {
            match n {
                n if n > 20 => 3
                _ => 2
            }
        } else {
            if n > 5 { 1 } else { 0 }
        }
    }
    check(complexFlow(25) == 3, "complex flow n=25 -> 3")
    check(complexFlow(15) == 2, "complex flow n=15 -> 2")
    check(complexFlow(8) == 1, "complex flow n=8 -> 1")
    check(complexFlow(3) == 0, "complex flow n=3 -> 0")

    // ─── 大胆：flag + break 替代 return（Bug #18 绕过）───
    fun findFirstEven(arr: i32[]): i32 {
        var result: i32 = -1
        var fi: i32 = 0
        while fi < arr.len() {
            if arr[fi] % 2 == 0 {
                result = arr[fi]
                break
            }
            fi = fi + 1
        }
        result
    }
    check(findFirstEven([1, 3, 5, 8, 9]) == 8, "find first even = 8")
    check(findFirstEven([1, 3, 5]) == -1, "find first even none = -1")
    check(findFirstEven([2, 4, 6]) == 2, "find first even = 2")

    // ─── 大胆：深递归 + match 组合（collatz 已移至顶层，避开 Bug #19）───
    // 注意：collatz(27) 需 111 层递归，触发疑似栈/帧耗尽 hang（见 Bug #37）
    check(collatz(1, 0) == 0, "collatz(1) = 0 steps")
    check(collatz(2, 0) == 1, "collatz(2) = 1 step")
    check(collatz(4, 0) == 2, "collatz(4) = 2 steps")
    check(collatz(8, 0) == 3, "collatz(8) = 3 steps")
    check(collatz(16, 0) == 4, "collatz(16) = 4 steps")
    check(collatz(7, 0) == 16, "collatz(7) = 16 steps")

    // ─── Bug #37：while 条件中调用用户函数（已修复）───
    fun isDone(n: i32): bool { n >= 5 }
    var func_cond_count: i32 = 0
    var fci: i32 = 0
    while isDone(fci) == false {
        func_cond_count = func_cond_count + 1
        fci = fci + 1
    }
    check(func_cond_count == 5, "while with user func condition = 5 (Bug #37 fixed)")

    // ─── 大胆：嵌套 if 在 match arm 中 ───
    fun gradeWithBonus(score: i32, has_bonus: bool): str {
        val effective = if has_bonus { score + 5 } else { score }
        match effective {
            s if s >= 90 => "A"
            s if s >= 80 => "B"
            s if s >= 70 => "C"
            _ => "F"
        }
    }
    check(gradeWithBonus(85, true) == "A", "85 + bonus -> A")
    check(gradeWithBonus(85, false) == "B", "85 no bonus -> B")
    check(gradeWithBonus(65, true) == "C", "65 + bonus -> C")
    check(gradeWithBonus(65, false) == "F", "65 no bonus -> F")

    // ─── 大胆：循环内累加 + 条件过滤 ───
    var filtered_sum: i32 = 0
    var ffi: i32 = 0
    while ffi < 20 {
        if ffi % 3 == 0 {
            filtered_sum = filtered_sum + ffi
        }
        ffi = ffi + 1
    }
    // 0 + 3 + 6 + 9 + 12 + 15 + 18 = 63
    check(filtered_sum == 63, "filtered sum (mod 3) = 63")

    summary()
}
